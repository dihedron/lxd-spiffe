# shellcheck shell=bash disable=SC2034 # settings, read by lab.sh
# Settings of the lxd-spiffe lab (see .specs/lxd-test-environment.md).
#
# Every setting has its default here. To change one for a single machine, set
# it in lab.local.env next to this file (git-ignored); to change it for one
# command, set it in the environment. The environment wins over lab.local.env,
# which wins over this file.

# --- Scenarios ----------------------------------------------------------------

# Default of every command's --scenario: "probe", "plugins" or "probe plugins".
# "plugins" is built with the plugins' end-to-end step; until then it is
# refused.
LAB_SCENARIOS="probe"

# --- Versions -----------------------------------------------------------------

# Ubuntu release of the lab's VMs.
LAB_UBUNTU_RELEASE="24.04"
# Cloud image of the VMs; empty: derived from the release. Set it to use a
# mirror.
LAB_UBUNTU_IMAGE_URL=""
# SHA-256 of the image; empty: read from the SHA256SUMS published next to it.
# Needed for a mirror without one.
LAB_UBUNTU_IMAGE_SHA256=""
# Snap channels of the two standalone LXD servers. Refreshes are held: the
# servers move only on "lab.sh refresh".
LAB_LXD5_CHANNEL="5.21/stable"
LAB_LXD6_CHANNEL="latest/stable"
# Snap revisions to pin; empty: the channel's current revision at "up".
LAB_LXD5_REVISION=""
LAB_LXD6_REVISION=""
# Images of the baseline instances, as REMOTE:ALIAS. Ubuntu comes from
# Canonical's "ubuntu:" remote ("images:" only has Ubuntu desktop images);
# the others from "images:", in their cloud variant (with cloud-init).
LAB_IMAGE_UBUNTU="ubuntu:24.04"
LAB_IMAGE_DEBIAN="images:debian/12/cloud"
LAB_IMAGE_ALPINE="images:alpine/3.24/cloud"

# --- Plugins (the "plugins" scenario) -----------------------------------------

# SPIRE release (e.g. "1.15.3") and the SHA-256 of its linux-amd64 tarball;
# empty: the most recent release compatible with the plugin SDK in go.mod,
# resolved at "up". A pinned version needs its SHA-256.
LAB_SPIRE_VERSION=""
LAB_SPIRE_SHA256=""
# Trust domain of SPIRE Server.
LAB_TRUST_DOMAIN="lxd.lab"
# Proof modes the server plugin enables; config_push adds can_edit to the
# spire identity's grants.
LAB_SPIRE_MODES="file_pull config_push"

# --- Topology -----------------------------------------------------------------

# "yes": add the three-node cluster (node1-node3). Built with gate L11; until
# then it is refused.
LAB_CLUSTER="no"
# Storage driver of the LXD servers: zfs (on a loop file) or dir.
LAB_LXD_STORAGE="zfs"
# Size (GiB) of each LXD server's ZFS loop file, inside the VM's disk.
LAB_LXD_ZFS_GIB="30"

# --- Network ------------------------------------------------------------------

# libvirt NAT network of the lab, and its IPv4 subnet (a /24). The network's
# name also prefixes the lab's libvirt domains.
LAB_NETWORK="lxd-lab"
LAB_SUBNET="10.251.0.0/24"
# Host part of each address in LAB_SUBNET; the lab host is .1.
LAB_LXD5_HOST="10"
LAB_LXD6_HOST="11"
LAB_NODE1_HOST="21"
LAB_NODE2_HOST="22"
LAB_NODE3_HOST="23"
LAB_SPIRE_HOST="30"

# --- Sizes --------------------------------------------------------------------

# vCPUs, RAM (GiB) and disk (GiB) of each VM: the standalone LXD servers
# (lxd5, lxd6), the cluster nodes, and spire.
LAB_LXD_VCPUS="4"
LAB_LXD_RAM_GIB="8"
LAB_LXD_DISK_GIB="60"
LAB_NODE_VCPUS="2"
LAB_NODE_RAM_GIB="4"
LAB_NODE_DISK_GIB="40"
LAB_SPIRE_VCPUS="2"
LAB_SPIRE_RAM_GIB="3"
LAB_SPIRE_DISK_GIB="20"
# vCPUs and RAM (GiB) of the virtual machines inside LXD (v-ubuntu, ...).
LAB_GUEST_VM_VCPUS="1"
LAB_GUEST_VM_RAM_GIB="1"

# --- Locations ----------------------------------------------------------------

# Lab state: PKI, SSH key, tokens, env.json. Relative paths are relative to
# this directory. Removed by "down".
LAB_STATE_DIR=".state"
# Downloaded images, kept across "down".
LAB_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lxd-spiffe-lab"
# Tools the lab installs without root (e.g. Go).
LAB_TOOLS_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lxd-spiffe-lab/tools"
# libvirt storage pool of the VM disks, and its directory.
LAB_POOL="lxd-lab"
LAB_POOL_DIR="/var/lib/libvirt/images/lxd-lab"

# --- Behaviour ----------------------------------------------------------------

# Non-empty: answer yes to the preflight's installation prompt.
LAB_ASSUME_YES=""
